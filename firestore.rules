rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    function isOwnerEmail() {
      return isAuth() && request.auth.token.email == 'thomasdhickman@gmail.com';
    }
    // True if the signed-in user is listed in ownerUid's household members.
    function isMemberOf(ownerUid) {
      return exists(/databases/$(database)/documents/users/$(ownerUid)/meta/household)
        && request.auth.uid in get(/databases/$(database)/documents/users/$(ownerUid)/meta/household).data.members;
    }

    // Founder may override any household's subscription (admin panel).
    match /users/{uid}/meta/subscription {
      allow write: if isOwnerEmail();
    }

    // All per-user data — singleton meta docs (profile/subscription/household)
    // plus tool data (notes, finance, food, chores, maintenance, …).
    // Accessible by the account owner OR any of their household members.
    match /users/{uid}/{document=**} {
      allow read, write: if isAuth() && (request.auth.uid == uid || isMemberOf(uid));
    }

    // ── Invite codes (household sharing) ────────────────────────────────────
    match /invites/{code} {
      allow read: if isAuth();
      allow create: if isAuth() && request.resource.data.ownerUid == request.auth.uid;
      allow update: if isAuth()
        && (request.auth.uid == resource.data.ownerUid
            || request.auth.uid == request.resource.data.usedBy);
      allow delete: if isAuth() && request.auth.uid == resource.data.ownerUid;
    }

    // ── Registrations (admin panel roster) ──────────────────────────────────
    match /registrations/{uid} {
      allow create, update: if isAuth() && request.auth.uid == uid;
      allow read: if isOwnerEmail();
    }

    // ── Legacy shared data (owner-only, used once for migration) ─────────────
    match /finance/{doc} { allow read, delete: if isOwnerEmail(); }
    match /todos/{doc}   { allow read, delete: if isOwnerEmail(); }
    match /config/{doc}  { allow read, delete: if isOwnerEmail(); }

    // Everything else is denied by default.
  }
}
