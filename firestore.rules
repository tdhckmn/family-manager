rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Beta allowlist ───────────────────────────────────────────────────────
    // Keep this list in sync with ALLOWED_EMAILS in src/components/AuthGate.tsx.
    function allowedEmails() {
      return [
        'thomasdhickman@gmail.com'
      ];
    }
    function isAllowed() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in allowedEmails();
    }
    function isOwner() {
      return request.auth != null
        && request.auth.token.email == 'thomasdhickman@gmail.com';
    }

    // ── Per-user private data ────────────────────────────────────────────────
    // Each user can only ever touch their own subtree, and only if allowlisted.
    match /users/{uid}/{document=**} {
      allow read, write: if isAllowed() && request.auth.uid == uid;
    }

    // Owner can read/write any user's subscription doc (for admin overrides).
    match /users/{uid}/sub/{doc} {
      allow read, write: if isOwner();
    }

    // ── User registry ────────────────────────────────────────────────────────
    // Each user writes their own profile (uid, email, displayName, lastSeen).
    // Owner can read all entries for the admin panel.
    match /registry/{uid} {
      allow write: if request.auth != null && request.auth.uid == uid;
      allow read: if isOwner() || (request.auth != null && request.auth.uid == uid);
    }

    // ── Coupon codes ─────────────────────────────────────────────────────────
    // Owner manages coupons. Authenticated users can read a specific coupon
    // to redeem it (getDoc only — no list access for non-owners).
    match /coupons/{code} {
      allow read, write: if isOwner();
      allow get: if isAllowed();
    }

    // ── Legacy shared data (pre-isolation) ───────────────────────────────────
    // Only the owner may read/delete these — used once to migrate into their
    // per-user space, then safe to remove. No one else can access them.
    match /finance/{doc} { allow read, delete: if isOwner(); }
    match /todos/{doc}   { allow read, delete: if isOwner(); }
    match /config/{doc}  { allow read, delete: if isOwner(); }

    // Everything else is denied by default.
  }
}
