{
  "name": "equanimity-monorepo",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "build:web": "pnpm --filter web build",
    "dev:web": "pnpm --filter web dev",
    "deploy": "pnpm build:web && firebase deploy --only hosting,firestore",
    "metro": "pnpm --filter equanimity-mobile start",
    "ios": "pnpm --filter equanimity-mobile ios",
    "android": "pnpm --filter equanimity-mobile android",
    "build:android": "pnpm --filter equanimity-mobile build:android",
    "build:android:release": "pnpm --filter equanimity-mobile build:android:release"
  }
}
