# Copy this file to .env and fill in your values
# Firebase project config (from Firebase Console → Project Settings → Your Apps)
VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id

# Stripe (optional — required only for paid subscriptions)
# Create a Payment Link in Stripe Dashboard → Payment Links, then paste the URL here.
# The link is shown to users when their trial expires.
VITE_STRIPE_PAYMENT_LINK=https://buy.stripe.com/your-payment-link

# For the Firebase Functions webhook (set via Firebase CLI, not .env):
#   firebase functions:config:set stripe.secret="sk_live_..." stripe.webhook_secret="whsec_..."
# Then add a webhook endpoint in Stripe Dashboard pointing to:
#   https://<region>-<project-id>.cloudfunctions.net/stripeWebhook
