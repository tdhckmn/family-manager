# Copy this file to .env and fill in your values

# ── Firebase ──────────────────────────────────────────────────────────────────
# From Firebase Console → Project Settings → Your Apps → Web app config
VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id

# ── Stripe (optional — required only for paid subscriptions) ──────────────────
# Create a Payment Link in Stripe Dashboard → Payment Links, then paste the URL here.
# The link is shown to users when their trial expires.
VITE_STRIPE_PAYMENT_LINK=https://buy.stripe.com/your-payment-link

# The Stripe webhook runs on a free Cloudflare Worker (NOT Firebase Functions —
# this project stays on the free Spark plan). See cloudflare-worker/stripe-webhook.js.
# Set these as Worker secrets (wrangler secret put …), not here:
#   STRIPE_WEBHOOK_SECRET, STRIPE_SECRET_KEY, and Firebase service-account creds.
# Point the Stripe webhook endpoint at the deployed Worker URL.

# ── Weather (WeatherAPI.com free tier) ────────────────────────────────────────
# https://www.weatherapi.com/ — free tier (1M calls/mo, commercial use OK).
# Use a FREE-TIER key with NO billing attached: the key ships in the client
# bundle, so the worst case of exposure is an exhausted quota, never a charge.
# If unset, the calendar simply hides weather.
VITE_WEATHERAPI_KEY=
