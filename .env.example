# Copy this file to .env and fill in your values
# Firebase project config (from Firebase Console → Project Settings → Your Apps)
VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id

# Anthropic API key for AI recipe generation in the food planner
# Note: this is bundled in the client — fine for a private family app
# For production, move the /v1/messages call to a Firebase Function
VITE_ANTHROPIC_API_KEY=sk-ant-...
