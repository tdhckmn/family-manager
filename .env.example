# Copy this file to .env and fill in your values

# ── Firebase ──────────────────────────────────────────────────────────────────
# From Firebase Console → Project Settings → Your Apps → Web app config
VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id

# ── Weather (WeatherAPI.com free tier) ────────────────────────────────────────
# https://www.weatherapi.com/ — free tier (1M calls/mo, commercial use OK).
# Use a FREE-TIER key with NO billing attached: the key ships in the client
# bundle, so the worst case of exposure is an exhausted quota, never a charge.
# If unset, the calendar simply hides weather.
VITE_WEATHERAPI_KEY=

# ── Stripe (Phase 2) ──────────────────────────────────────────────────────────
# Create Payment Links in Stripe Dashboard → Payment Links.
# Set success_url to your app domain so Stripe redirects back after payment.
# Optional — if not set, subscribe page shows "Coming soon" on those buttons.
VITE_STRIPE_MONTHLY_LINK=
VITE_STRIPE_YEARLY_LINK=

# ── Cloudflare Worker (Stripe webhook) ────────────────────────────────────────
# These go in Cloudflare Worker secrets (not here). See cloudflare-worker/stripe-webhook.js.
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_SECRET_KEY=sk_live_...
# FIREBASE_PROJECT_ID=family-manager-7bb7d
# FIREBASE_CLIENT_EMAIL=...@...iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n
